      value: Mom
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[0].dialogueBoxes.Array.data[1].nameTag
      value: Pepper
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[0].dialogueBoxes.Array.data[2].nameTag
      value: Mom
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[1].dialogueBoxes.Array.data[0].nameTag
      value: Mom
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[1].dialogueBoxes.Array.data[1].nameTag
      value: Mom
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[1].dialogueBoxes.Array.data[2].nameTag
      value: Mom
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[2].dialogueBoxes.Array.data[0].nameTag
      value: Mom
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[2].dialogueBoxes.Array.data[1].nameTag
      value: Pepper
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[0].dialogueBoxes.Array.data[0].dialogueText
      value: Hi, Pepper! Did you have a good day?
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[0].dialogueBoxes.Array.data[1].dialogueText
      value: I did! Salt and I played video games, and then he gave me his old Tick
        Token.
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[0].dialogueBoxes.Array.data[2].dialogueText
      value: Sounds fun, dear.
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[1].dialogueBoxes.Array.data[0].dialogueText
      value: Don't forget in all of the celebrations, I'm proud of you, too.
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[1].dialogueBoxes.Array.data[1].dialogueText
      value: You're shaping up to be a wonderful young woman, and if you ask me,
        staying here and enduring the unknown is just as impressive a feat as pioneering
        another planet.
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[1].dialogueBoxes.Array.data[2].dialogueText
      value: Sounds fun, dear.
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[2].dialogueBoxes.Array.data[0].dialogueText
      value: I love you, Pepper.
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194405, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: _NPCLines.Array.data[2].dialogueBoxes.Array.data[1].dialogueText
      value: I love you, too, Mom.
      objectReference: {fileID: 0}
    - target: {fileID: 1155657993595194406, guid: efd95256c89a0e549b3a64a469c98391, type: 3}
      propertyPath: facingDirection
      value: 1
