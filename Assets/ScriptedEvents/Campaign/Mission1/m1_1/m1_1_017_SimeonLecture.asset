%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m1_1_017_SimeonLecture
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: You should know better, Tamago.
      nameTag: Stern Partygoer
      portrait: {fileID: 0}
    - dialogueText: Looks aren't a base for a healthy relationship.
      nameTag: Stern Partygoer
      portrait: {fileID: 0}
    - dialogueText: Look, Simeon, I never said-
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: And what's all this business making fun of the Small Step mission?
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: People will be risking their lives to secure a future for all
        of us. That's no laughing matter.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: That we've even made it as far as today is a testament to the
        combined millennia of effort people across the world made over the last century,
        all because they had a dream.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: They dreamed that in the face of annihilation, that through their
        hardest efforts, and no matter how small their individual contributions,
        they could achieve salvation.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: You should know better than to mock the culmination of that dream,
        Tamago.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: But,-
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: And, to you, I just want to apologize on behalf of my brother
        for wasting your time.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: What?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I was having fun.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: It's ok.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: You don't need to pretend to be enjoying yourself for my brother's
        sake.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: He has so many frivolous habits he needs to get over.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: Simeon! I'm right here!
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: I thought you wanted me to take initiative!
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Here I am, stepping out of my comfort zone and trying to make
        a friend, and you're just insulting me for it!
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: You have a point. Sorry.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: But, that still doesn't excuse your jokes from being disrespectful.
      nameTag: Simeon
      portrait: {fileID: 0}
    - dialogueText: Oh, would you just mind your own business, for once?!
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: How'm I supposed to take initiative if you keep making my decisions
        for me?
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
