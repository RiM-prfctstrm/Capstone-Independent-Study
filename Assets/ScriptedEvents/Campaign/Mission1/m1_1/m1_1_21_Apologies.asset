%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m1_1_21_Apologies
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: ...I'm sorry you had to see that.
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Is that your brother?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah.
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: He just makes me so mad sometimes!
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: But, I don't wanna be any more of a downer.
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Can we talk about something else, please?
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Sure!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: What'd he say your name was, again?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Oh, right! I never introduced myself.
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Sorry 'bout that.
      nameTag: Disoriented Cute Boy
      portrait: {fileID: 0}
    - dialogueText: I'm Tamago Jackson.
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: My name's Pepper Shaker.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Nice to meet you, Tamago!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Oh, uh, nice to meet you, too, Pepper.
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: I take it you're related to Saul?
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: Yeah. He's my big brother.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: We call him Salt.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I hope he's not as annoying as mine can be.
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: Um, thanks?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: ...Wait, yours isn't Professor Jackson, is he?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Huh? Yeah, he's a professor.
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: Why?
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: Ohhhhhhh, that explains so much!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Salt always said his Professor Jackson was a big stick in the
        mud.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Haha. You can say that again.
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: Though, truth be told, he is just trying to look out for me.
      nameTag: Tamago
      portrait: {fileID: 0}
    - dialogueText: Yeah, that's what I figured.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: He could still be a little gentler, though.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah.
      nameTag: Tamago
      portrait: {fileID: 0}
