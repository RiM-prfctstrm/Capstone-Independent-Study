  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: I'm really glad you like my jokes.
      nameTag: Disorientingly Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Tell you the truth, I had actually thought about walking up to
        you and telling you some before you came over.
      nameTag: Disorientingly Cute Boy
      portrait: {fileID: 0}
    - dialogueText: You did?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah.
      nameTag: Disorientingly Cute Boy
      portrait: {fileID: 0}
    - dialogueText: I saw you over there on the other side of the roof, and I thought
        you were cute.
      nameTag: Disorientingly Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Oh? Really?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Thank you!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Really? Looks? That's what you care about?
      nameTag: ???
      portrait: {fileID: 0}
