MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m1_0A_009_SpeechMeat
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Thank you!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It means so much to me that you're here.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It has been wonderful growing up on Cradle, and even more wonderful
        getting to grow up with you.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You've taken care of me; you've made my memories; you've turned
        my bad days into good ones.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You've all given me such great gifts that I know I'll never be
        able to repay.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Because of that, if I don't make it, or the whole Small Step
        mission proves to be in vain...
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Even if the sun goes out tomorrow, I'll be happy.
      nameTag: Salt
      portrait: {fileID: 0}
