%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m1_2_005_SaltInLove
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: You know, you didn't have to go out here all alone.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'd've been happy to spot you.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I figured if God wants me on this mission, he'd keep my head
        out of the water 'til I get there.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Ah, you were praying.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yep. With both my mind and body.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: How's that work?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Well, we're always enveloped by the air or the water.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It's God's way of giving us hugs, and I'm just being happy to
        receive.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Tell you the truth, if I was sure nobody'd be around, I'd go
        skinny-dipping so I could directly receive even more of it.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Haha, you're crazy.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Crazy in love!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: With God??
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: And the world he put me in.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Gross!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: You say that, but have you ever prayed while you were taking
        a bath?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Well, I guess if that's what you mean...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: But did you have to say it like that??
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: For this reaction, absolutely!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Salt!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Hey, that's what brothers are for.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Oh, you.
      nameTag: Pepper
      portrait: {fileID: 0}
