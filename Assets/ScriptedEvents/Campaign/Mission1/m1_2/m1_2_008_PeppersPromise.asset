%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m1_2_008_PeppersPromise
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: You know, Peps, I have another promise I want you to make.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It's something I've been thinking about a while.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Really? What is it?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I want you to keep having adventures.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I want you to make friends with everyone you meet, and to do
        things you'd never imagined.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I want for you to go out and fall in love with this world the
        same way that I have.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: And when we meet again, whether it's on Pearl or in heaven, I
        want you to tell me all about it, to tell me things I never would have known
        about this beautiful planet.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: And if it's even possible, to make Pearl look boring in comparison.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Can you do that for me?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I don't understand, why are you asking me to do this?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Please, trust me. You'll understand why once you've done it.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Uh, okay.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'll do it.
      nameTag: Pepper
      portrait: {fileID: 0}
