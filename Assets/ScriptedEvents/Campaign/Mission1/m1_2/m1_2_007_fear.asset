%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m1_2_007_fear
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Y'know, Salt...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'm scared.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: '''Cause, there''s just so many ways you can die out there.'
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: And I'll be back here, and I won't be able to know if you're
        alive or dead when I think of you, cause I can't hear about you for years.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: What am I supposed to do?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I don't know, Peps.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: ' I don''t know.'
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: See, I'm scared of the same thing, too.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: The sun could blow up at any moment, and I can't know if you're
        alive either.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I wanna hope you're alive, but I don't think I can force myself
        to believe it.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Hmmm...
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: What is it?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Tell you what, Pepper.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: If I die, I'll have my soul go by you and Mom and Dad on my way
        to heaven.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It's a promise.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Can you even do that?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I keep my promises.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Then, I promise you I'll do the same!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Thank you, Pepper. Thank you very much.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Mhm. You're welcome.
      nameTag: Pepper
      portrait: {fileID: 0}
