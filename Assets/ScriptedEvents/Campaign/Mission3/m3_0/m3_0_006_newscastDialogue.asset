%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m3_0_006_newscastDialogue
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Today, the Interstellar Communications Observatory received a
        message marking an important moment for the worldwide evacuation effort,
        Project Giant Leap, and in history.
      nameTag: News Anchor
      portrait: {fileID: 0}
    - dialogueText: Who cares!? Don't you know how hard it is to get a decent ad
        slot for 20 dollars?
      nameTag: Alexandria
      portrait: {fileID: 0}
    - dialogueText: Shhh! I wanna hear!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: You can't shush me! I'm your boss!
      nameTag: Alexandria
      portrait: {fileID: 0}
    - dialogueText: I get to shush you!
      nameTag: Alexandria
      portrait: {fileID: 0}
    - dialogueText: The Small Step Advance Mission had arrived at its destination,
        the Cradle-like exoplanet Pearl, and at the time of sending, was in orbit.
      nameTag: News Anchor
      portrait: {fileID: 0}
    - dialogueText: He made it!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I also get to fire you, in case you wanna keep interrupting.
      nameTag: Alexandria
      portrait: {fileID: 0}
    - dialogueText: The mission's next step is to find suitable landing spots to
        set up colonies, which will be the first Cradlean settlements on another
        planet.
      nameTag: News Anchor
      portrait: {fileID: 0}
    - dialogueText: I hope you like it there, Salt.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: "Shame I can't fire the news guys, too. That would be nice.\r"
      nameTag: Alexandria
      portrait: {fileID: 0}
    - dialogueText: Wait, what are you going on about?
      nameTag: Alexandria
      portrait: {fileID: 0}
    - dialogueText: My brother! He was on the mission.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Hmph.
      nameTag: Alexandria
      portrait: {fileID: 0}
    - dialogueText: As a reminder to our viewers, due to the distance between Cradle
        and Pearl, messages between the two are received approximately five years
        after they are sent.
      nameTag: News Anchor
      portrait: {fileID: 0}
    - dialogueText: While the current status of the colonies is unknown, the fact
        of Small Step's arrival is still something to be celebrated.
      nameTag: News Anchor
      portrait: {fileID: 0}
    - dialogueText: Their safe journey suggests the global exodus phase of Project
        Giant Leap will run smoothly.
      nameTag: News Anchor
      portrait: {fileID: 0}
    - dialogueText: We can rest assured knowing are future survival is in capable
        hands.
      nameTag: News Anchor
      portrait: {fileID: 0}
    - dialogueText: And now, back to your regularly scheduled program.
      nameTag: News Anchor
      portrait: {fileID: 0}
