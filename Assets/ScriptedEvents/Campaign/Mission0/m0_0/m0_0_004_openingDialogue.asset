  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: One minute remains!
      nameTag: Angelsphere 3
      portrait: {fileID: 0}
    - dialogueText: Ugh! They're so far ahead.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Don't worry, Peps, We've come back from worse.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Maybe when you had a good spot to snipe from.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: That's not gonna work on an indoor map!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Hey, I found a cloak! Maybe you can use it to scout.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Sounds good. Where is it?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: 'Server room. I''ll make sure nobody steals it.

'
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: "Thanks.\r"
      nameTag: Pepper
