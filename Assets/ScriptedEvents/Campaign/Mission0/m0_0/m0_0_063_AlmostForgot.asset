  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_063_AlmostForgot
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Oh, I almost forgot!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: The Tick Token will home in on your position before it homes
        in on mine.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Also, the pouch I made to hold the blips is a little rickety.
        If you jostle it too hard, they'll fall out.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: And, the thing gets really bad glare outdoors. If you can't read
        it, uh...
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I dunno, go barge into someone's house or something.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Gotcha. Will do!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: All right, then I'll see ya!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Good luck!
      nameTag: Salt
      portrait: {fileID: 0}
