  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_024_DeliveryBye
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Man, you don't know what a thrill it is to finally meet someone
        who gets it.
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: I'd love to talk more, but I'm on the clock.
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Oh, sorry, I must be wasting your time.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Hey, no worries. Meeting people like you is, like, the best part
        of my job.
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: It's kinda like it's own pay, no?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: "Hm.\r"
      nameTag: Salt
      portrait: {fileID: 0}
