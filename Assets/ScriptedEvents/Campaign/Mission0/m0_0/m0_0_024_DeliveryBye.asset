  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_024_DeliveryBye
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: See, that's what I've been saying!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Man, you don't know what a thrill it is to finally meet someone
        who gets it.
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: I'd love to talk more, but I was just standing here half an hour,
        and I'm supposed to be on the clock.
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Oh, crap, sorry! I had no idea!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Hey, no worries. Meeting people like you is, like, the best part
        of my job.
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: It's a kind of pay in its own way, no?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Hmmm...
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Hmmm...
      nameTag: Salt
      portrait: {fileID: 0}
