--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_059_LooksLikeABomb
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: And... done! Ta-da!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Uh... It looks like a bomb.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: No, it doesn't!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You just don't understand my artistic sensibilities!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: But, it's got, like, the wires, and the timer, and the tape,
        and-
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Alright, alright, I get it!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: There's plenty of other things that have that kind of stuff!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Like what?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Like, ...uh...
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: See? I'll get in trouble if I wear it.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Look, I promise you no one else is going to mistake it for a
        bomb, OK?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Just try it.
      nameTag: Salt
      portrait: {fileID: 0}
