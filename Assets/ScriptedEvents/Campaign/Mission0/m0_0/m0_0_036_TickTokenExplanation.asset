--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_036_TickTokenExplanation
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: So, Salt...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah, Peps?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: What's the point of getting a new watch if you're not going to
        have days anymore?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Well, we're keeping to mission control's time zone for easy communication
        and healthy sleep.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Plus, I can always know what time it is for you.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: But doesn't your old one do all that, too?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah, but, they're giving me a ridiculous bonus, and once we
        take off, I'll have nothing to spend it on for ten years.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Might as well splurge on something useful.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Not something fun?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: If the spaceship doesn't have enough amenities to keep me occupied
        outside work, I'll just admire the stars.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Once we get to Pearl, we'll be too excited from all the new discoveries
        to need anything else.
      nameTag: Salt
      portrait: {fileID: 0}
