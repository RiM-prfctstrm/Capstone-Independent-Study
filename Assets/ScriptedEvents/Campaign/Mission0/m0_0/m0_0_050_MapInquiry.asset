  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Hey, Salt, I see you put some markers on it, but it won't let
        me see where I am.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Oh, yeah, this is an overseas model from New Aeland.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It runs on GPS, so some functions won't work in places where
        there are spaceyards, like here.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Here, why don't you let me take a look at it for a sec?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Sure.
      nameTag: Pepper
      portrait: {fileID: 0}
