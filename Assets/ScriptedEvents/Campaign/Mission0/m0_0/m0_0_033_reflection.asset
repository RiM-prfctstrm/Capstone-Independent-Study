MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_033_reflection
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Heh, you think? Just tryin' to be kind.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: No, I mean that guy.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Even after missing all that time he could have been working,
        he didn't seem worried about it.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Like, it didn't matter to him whether he was doing his work well
        as much as whether he was enjoying it.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah, you're right.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: He must have such a happy life. I wanna be like that, too.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Well, if you wanna do that, first, you'd have to watch X Breaker.
        All 12 seasons.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Or, are you just telling me it's now your life's goal to be a
        professional gofer?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: No, that's not-
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Hehehe!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You're insufferable.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I hope you sleep in and miss your precious mission.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I love you, too.
      nameTag: Salt
      portrait: {fileID: 0}
