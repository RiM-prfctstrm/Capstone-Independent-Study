%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_033_reflection
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Heh, you think? Just tryin' to be kind.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: No, I mean that guy.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'm just impressed with how happy he is running deliveries.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Like, that's not a special job. You wouldn't think he'd care
        so much.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: "I mean, Dad's happy, and all he does is wash the dishes.\r"
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Or maybe, he figured out how to make it special?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: You don't need to be on an elite mission to save all Cradleans
        to be fulfilled.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Or, are you just telling me it's now your life's goal to be a
        professional gofer?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: No, that's not-
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Hehehe!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You're insufferable.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I hope you sleep in and miss your precious mission.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I love you, too.
      nameTag: Salt
      portrait: {fileID: 0}
