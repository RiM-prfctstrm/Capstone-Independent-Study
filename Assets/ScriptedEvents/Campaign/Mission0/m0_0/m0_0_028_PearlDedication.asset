  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_028_PearlDedication
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Huh?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: What's your name?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Uh...
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: I'm Mark Erie.
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Well, I'll tell you what, Mark.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I'm part of the Small Step mission. Once I get to Pearl, I'll
        name something there after you.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It's a promise.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: "No way! Small Step!?\r"
      nameTag: Mark Erie
      portrait: {fileID: 0}
    - dialogueText: Thank you so much, sir!
      nameTag: Mark Erie
      portrait: {fileID: 0}
    - dialogueText: You're welcome. Have a good rest of your day.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You, too!
      nameTag: Mark Erie
      portrait: {fileID: 0}
