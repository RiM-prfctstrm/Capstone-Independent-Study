%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_023_DeliveryExchange
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Thank you!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: No problem-Oh!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Your shirt... is that a Buster Angel Excaligun?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Oh, this? It's actually from X Breaker.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: X Breaker!? I didn't know anyone else liked that!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Its cheesiness is matched only by its awesomeness.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I know, right? Got a favorite character?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Hmmm...
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: If I had to choose one...
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I think I'd have to go with Aoyama.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: No way! Mine too!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: ...that's not just because of her role in the main series, right?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: No, I think X Breaker is where she really shines.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Finally, somebody else gets it! She had to join the Vacusects!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Of course, she did! They promised her Friedrich would be safe.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: But, what about when Midorime killed him?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: She was too stubborn not to blame the Breaker Force for that.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: That's what I've been saying!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Ahhh...
      nameTag: Delivery Boy
      portrait: {fileID: 0}
