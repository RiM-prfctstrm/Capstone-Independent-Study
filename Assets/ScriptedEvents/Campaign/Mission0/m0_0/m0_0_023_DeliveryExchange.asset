  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_023_DeliveryExchange
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Thank you!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: No problem-Oh!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Your shirt... is that a Buster Angel Excaligun?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Oh, this? It's actually from X Breaker.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: X Breaker!? I didn't know anyone else liked that!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Its cheesiness is matched only by its awesomeness.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I know, right? Got a favorite character?
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: You try to follow along with their conversation, but their nerdiness
        is too powerful.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: You can at least see how happy they are, and that makes you happy,
        too.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: You find yourself engrossed despite not understanding anything.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: See, that's what I've been saying!
      nameTag: Delivery Boy
      portrait: {fileID: 0}
    - dialogueText: Ahhh...
      nameTag: Delivery Boy
      portrait: {fileID: 0}
