MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_014_gtg
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Good game.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Mmmf. Good game...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: But, I demand a rematch!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Sorry, Peps.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: "I gotta get ready for the trip.\r"
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: "C'mooonnnnn Salt, we've only got so much time left.\r"
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: "I know. That's why we gotta use it well, and not get bored playing
        the same game for days on end.\r"
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: "But, Saaaaalt...\r"
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: It could be our last chance.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I mean, we could still play while I'm gone.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I'd just have five years of ping.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: "Tell ya what, we'll play as much as you want when I'm done packing.\r"
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: It's a promise.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Thanks, Salt.
      nameTag: Pepper
      portrait: {fileID: 0}
