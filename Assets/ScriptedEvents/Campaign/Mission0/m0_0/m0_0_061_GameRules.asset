  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_0_061_GameRules
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: So, how do those nanoblip thingies work?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Well, I was thinking maybe I could show you with a game.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: A game?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah, it'll be fun. Lemme explain.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: So, the nanoblips work kinda like a GPS when you pick them up,
        yeah?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I'll set your Tick Token to home in on mine, and we're gonna
        play some hide-and-seek.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You'll pick up nanoblips to see where I am. Sound good?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Yeah!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Great! You count to a thousand, and I'll go hide.
      nameTag: Salt
      portrait: {fileID: 0}
