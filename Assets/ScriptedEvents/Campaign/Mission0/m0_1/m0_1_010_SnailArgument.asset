  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_1_010_SnailArgument
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: So, how did you stay in there so long without getting plowed
        out by kids?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: It would have ruined your hiding spot if you kept getting shoved
        out by the after-school crowd.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I used my superior acrobatic reflexes to dodge each and every
        child by bribing them with snails.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Haha, snails??
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: But, you can just pick those up anywhere!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Heh. They don't know that!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: GWAAAHAHAHA!!!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: But, how did you even get them?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Pepper, Pepper, you should know this by now.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: I always keep a pocket full of snails in case of an emergency.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Never know when they might come in handy.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: That's stupid.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: You're stupid.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Nuh-uh.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yuh-huh.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Nuh-uh!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yuh-huh!
      nameTag: Salt
      portrait: {fileID: 0}
