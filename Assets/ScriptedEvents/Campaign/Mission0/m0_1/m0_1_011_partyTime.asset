%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_1_011_partyTime
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Ah... I love playgrounds.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: They always bring out your inner child.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Maybe you're just a big baby.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Say that again, and I'll give you the noogie of a lifetime once
        you get down.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Joke's on you, I don't have to get down from here.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'm an adult, and I can do what I want.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yes, ya do.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: For one, you're still 14. Not nearly an adult.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: For another, we have a party to go to tonight, and we should
        probably get ready soon.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: The party?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: My goodbye party's this evening, remember?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Right! I can't believe I forgot!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: And, would you look at that?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You're already achieving your dream.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: You're losing yourself in the moment just like the delivery guy
        did.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Heh, I guess I am.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Well, let's go. The hors d'oeuvres aren't going to eat themselves.
      nameTag: Salt
      portrait: {fileID: 0}
