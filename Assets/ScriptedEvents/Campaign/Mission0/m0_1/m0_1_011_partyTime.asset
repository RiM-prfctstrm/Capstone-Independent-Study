%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m0_1_011_partyTime
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Ah... I love playgrounds.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: They always bring out your inner child.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Maybe you're just a big baby.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Say that again, and I'll give you the noogie of a lifetime once
        you get down.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Joke's on you, I don't have to get down from here.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'm an adult, and I can do what I want.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yes, ya do.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: For one, you're still seventeen for a couple more months. Not
        an adult.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: For another, we have a party to go to tonight, and we should
        probably get ready soon.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Darn... Forgot about that...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'm sure Mom would've called if it got too close.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Yeah...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: ...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Something wrong?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: -uh! No, no, I'm fine!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I just...
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Wasn't ready for the party yet, that's all.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Well, we didn't need to be ready yet. You have nothing to worry
        about.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: C'mon, let's get going.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Ok...
      nameTag: Salt
      portrait: {fileID: 0}
