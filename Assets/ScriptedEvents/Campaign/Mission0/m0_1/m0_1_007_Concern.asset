  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Wait, something went wrong!?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Well, I didn't say that, either.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I was just fine.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Don't fool me like that!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: If you'd gotten lost trying to find me, I'd never forgive myself.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Salt, I'm not gonna get lost here.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I know this part of town like the back of my head.
      nameTag: Pepper
      portrait: {fileID: 0}
