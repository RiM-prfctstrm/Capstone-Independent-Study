%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m2_0_006_Joking
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Heheh, I kinda am.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: I don't actually know anyone here.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: My brother dragged me over cause he thinks Saul's initiative
        will rub off on me.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: I didn't even know what Saul looked like until he gave his speech,
        so that's how that's going.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: Do you want me to introduce you?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Heh. No, thanks.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: I just need someone to make it look like I'm doing something
        important.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: That way, my brother'll probably stay off my case.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: Are you sure you don't want to meet him?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I'm sure he wouldn't mind.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Sorry, I don't want to.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: It's not like I have anything against the guy; I just know my
        brother's gonna be close in his orbit.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: I'd rather have more than a small step between us until it's
        time to go home.
      nameTag: Disoriented Boy
      portrait: {fileID: 0}
    - dialogueText: Hehe, small step.
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Was that on purpose?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: It would be a pretty giant leap to think it wasn't, no?
      nameTag: Disorienting Boy
      portrait: {fileID: 0}
    - dialogueText: Haha!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: That's good!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Thanks, I got it when I was hit by a laughteroid.
      nameTag: Disorienting Boy
      portrait: {fileID: 0}
    - dialogueText: Heheheh!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Those are pretty hard to come by, you know?
      nameTag: Disorienting Boy
      portrait: {fileID: 0}
    - dialogueText: Most of them burn up in the dadosphere.
      nameTag: Disorienting Boy
      portrait: {fileID: 0}
    - dialogueText: The dadosphere?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Yeah, like dad jokes, plus stratosphere.
      nameTag: Disorienting Boy
      portrait: {fileID: 0}
    - dialogueText: Oh!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Haha!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I hope Pearl's dadosphere isn't too thick for reentry.
      nameTag: Disorienting Cute Boy
      portrait: {fileID: 0}
    - dialogueText: "We wouldn\u2019t want Saul burning up with laughter, would we?"
      nameTag: Disorienting Cute Boy
      portrait: {fileID: 0}
    - dialogueText: BAHAHAHAHAHA!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: You gotta stop! I'm the one dying here!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I can't!
      nameTag: Disorienting Cute Boy
      portrait: {fileID: 0}
    - dialogueText: I already launched our hahaha-cket, and we ain't stopping 'til
        fly above the pun!
      nameTag: Disorienting Cute Boy
      portrait: {fileID: 0}
    - dialogueText: Hahahaha!
      nameTag: Pepper
      portrait: {fileID: 0}
