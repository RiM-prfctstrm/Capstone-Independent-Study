  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m2_2_009_LoveStory
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: In her first class four days later, sitting next to her was none
        other than Tamago Jackson.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: Since they were pursuing similar majors, they formed a study
        group together, though in reality, the two of them spent more time goofing
        off than actually studying.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: Eventually, they were too busy goofing off and staring into each
        other's eyes to do any work at all.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: They still kept "studying" together anyways.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: 392 days after their first classes, Pepper and Tamago went out
        with the express purpose of goofing off and staring in each other's eyes.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: It quickly became a habit.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: Needless to say, it was a miracle that, 1415 days after starting
        class, either of them graduated.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: The very next day, 1024 days after they started dating, Tamago
        asked Pepper's hand in marriage.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: She said yes.
      nameTag: 
      portrait: {fileID: 0}
