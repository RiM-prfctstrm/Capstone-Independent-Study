  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: m2_1_000_Greeetings
  m_EditorClassIdentifier: 
  eventComplete: 1
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: Salt, there you are!
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Hi, Peps!
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: What are you doing out here?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Why aren't you wearing a shirt?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: I wanted to go for a swim to say goodbye to the ocean, and now
        that I'm here, I realized it's my last chance to take a look at the stars.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: But, aren't they gonna be one of the few things that'll be the
        same on Pearl?
      nameTag: Pepper
      portrait: {fileID: 0}
    - dialogueText: Maybe individually, but I don't think any of our constellations
        are gonna be visible from there.
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Do you wanna sit down?
      nameTag: Salt
      portrait: {fileID: 0}
    - dialogueText: Sure.
      nameTag: Pepper
      portrait: {fileID: 0}
