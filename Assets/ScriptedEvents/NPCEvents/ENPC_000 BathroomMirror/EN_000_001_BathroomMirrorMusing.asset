--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4be391ce5ba198741a38dcaf9fd5b28d, type: 3}
  m_Name: EN_000_001_BathroomMirrorMusing
  m_EditorClassIdentifier: 
  eventComplete: 0
  cutsceneDialogue:
    dialogueBoxes:
    - dialogueText: There's an inquisitive girl looking back at you in the mirror.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: She's wondering about this creature standing before her.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: It's a creature she's very familiar with, but that still boggles
        her mind.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: She tends to think of it as a soul inside a body, but from here
        she is just as much the body as it is the soul.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: The creature raises its hand and brushes your cheek.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: The girl watches it feel the sensation in both finger and face.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: They feel so far apart and yet in the same place.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: They are so different but also the same.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: The girl becomes aware of the clothes pressing against the creature's
        skin.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: She feels like they're a part of her, but the creature can only
        feel them, and not with them.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: There is Tension.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: Is that... you?
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: You gaze at the girl gazing at the creature gazing at the girl
        gazing at you.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: All of them realize that all of them-and not just all of them,
        but all of all of them-from the gentlest finger to the grossest hair, are
        made from love, and in love, and to love.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: Then you blink, and you smile at yourself in the mirror.
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: Wait...
      nameTag: 
      portrait: {fileID: 0}
    - dialogueText: Is that a pimple?
      nameTag: 
      portrait: {fileID: 0}
